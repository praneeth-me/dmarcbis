{
  "name": "dmarcbis",
  "version": "0.1.0",
  "description": "A parser and validator for DMARC records, checked against RFC 9989 (DMARCbis) instead of the RFC 7489 every other DMARC checker still assumes.",
  "keywords": ["dmarc", "dmarcbis", "rfc9989", "dns", "email-security"],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node demo/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
